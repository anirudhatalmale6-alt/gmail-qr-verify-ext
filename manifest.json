{
  "manifest_version": 3,
  "name": "Gmail QR Auto-Verify",
  "version": "1.2.0",
  "description": "Handles Google QR verification during account creation",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.google.com/lifecycle/steps/signup/mophoneverification*",
        "https://accounts.google.com/lifecycle/steps/signup/phoneverification*",
        "https://accounts.google.com/lifecycle/steps/signup/deviceverification*"
      ],
      "js": ["jsqr.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
